# LLM Provider selection: ollama or gemini
LLM_PROVIDER=ollama
# LLM Provider selection: openrouter, gemini, or ollama
LLM_PROVIDER=openrouter

# OpenRouter settings (Generate free key at https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Gemini settings (Optional, get a free key at https://aistudio.google.com/api-keys)
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# Ollama local settings
# Ollama local settings (Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# Embedding and Reranker
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Storage paths
CHROMA_PATH=./data/chroma
UPLOAD_PATH=./data/uploads
SEED_DOCS_PATH=./data/seed_documents
SQLITE_PATH=./data/app.db

# Retrieval parameters
RETRIEVAL_TOP_K=10
RERANK_TOP_K=4
RELEVANCE_THRESHOLD=0.20

# Chunking parameters
CHUNK_SIZE=650
CHUNK_OVERLAP=80

# Safety limits
MAX_QUERY_LENGTH=2000
MAX_UPLOAD_SIZE_MB=50

